# Application
NODE_ENV=production
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# API Keys (Required)
# Get your Gemini API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Integration (Optional)
# Get your GitHub token from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Agent workspace root (absolute path where agents read/write files)
AGENT_WORKSPACE_ROOT=C:\\Users\\sidki\\source\\repos\\New folder (4)

# Database (Optional - uncomment if using PostgreSQL)
# DATABASE_URL=postgresql://agentic:changeme@postgres:5432/agentic

# Redis Cache (Optional - uncomment if using Redis)
# REDIS_URL=redis://redis:6379

# Application Settings
DEFAULT_MODEL=gemini-2.5-flash
MAX_CONCURRENT_AGENTS=5
DEFAULT_TIMEOUT=30

# Repository Settings
DEFAULT_REPO=https://github.com/sidkid78/diverse.git
DEFAULT_BRANCH=main

